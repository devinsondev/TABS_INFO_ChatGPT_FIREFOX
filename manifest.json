{
  "manifest_version": 3,
  "name": "ChatGPT Tab Safe Monitor",
  "version": "0.1.0",
  "description": "Privacy-first Firefox tab overview and user-triggered discard. Never reads ChatGPT messages or page DOM.",
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_title": "ChatGPT Tab Safe Monitor",
    "default_popup": "src/ui/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabs-info-chatgpt-firefox@devinsondev.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
